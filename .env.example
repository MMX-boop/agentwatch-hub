# Copy this file to ~/.agentwatch-notify/.env with `agentwatch-notify init`.
NOTIFY_ENABLED=true

# Existing Bark-only configs continue to work without BARK_ENABLED.
BARK_ENABLED=true
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
BARK_GROUP=AgentWatch
BARK_SOUND=minuet
BARK_LEVEL=active
BARK_ICON_URL=

# Optional QQ through a separately installed OneBot v11 HTTP server (e.g. NapCat).
# Up to 8 private:<QQ ID> / group:<group ID> entries, separated by commas.
QQ_ENABLED=false
ONEBOT_BASE_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
QQ_TARGETS=

# Optional Feishu custom group bot. Both URL and signing secret are sensitive.
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# off, boss, heir_male, heir_female, emperor, palace, butler,
# strategist, bestie, cat, cyber, detective
PERSONA=boss
CLAUDE_PERSONA=
CODEX_PERSONA=

# Optional OpenAI-compatible endpoint. Leave empty to use local templates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=180

# Optional HTTP(S) proxy origin, for example http://127.0.0.1:7890
OUTBOUND_PROXY=
